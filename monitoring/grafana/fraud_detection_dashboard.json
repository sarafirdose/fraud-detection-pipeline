{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Overview & Key Performance Indicators",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Transactions Per Second (TPS)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "transactions_per_second",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 40 }
            ]
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "Total Transactions Processed",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(total_transactions_processed)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Fraud Alerts Intercepted",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(fraud_alerts_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Active Account Profiles in Memory",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "active_accounts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Latency & Real-Time Performance Benchmarks",
      "type": "row"
    },
    {
      "id": 5,
      "title": "ML Inference Latency (p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ml_inference_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ml_inference_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 Latency (ms)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "title": "Stream Processing & Behavioral Profiling Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(stream_processing_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "Stream Latency p95 (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(behavioral_profile_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "Behavioral Profile p95 (ms)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Model Predictions & Pipeline Reliability",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Model Prediction Counts by Architecture",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "sum by (model_mode) (model_prediction_count_total)",
          "legendFormat": "{{model_mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Kafka Ingestion & API Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "sum(rate(kafka_errors_total[1m]))",
          "legendFormat": "Kafka Errors/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(system_errors_total[1m]))",
          "legendFormat": "System Errors/sec",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fraud", "streaming", "kafka", "ml", "prometheus"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
